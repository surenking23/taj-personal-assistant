# Copy to .env.deploy and replace both secrets before starting the deployment.
# Generate independently, for example with Python secrets.token_hex(32).
JARVIS_API_TOKEN=replace-with-a-random-64-character-hex-token
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-password

# The signed-in Copilot CLI session on Windows is not available inside this
# container. Select openai with OPENAI_API_KEY or ollama with a reachable server.
JARVIS_MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Keep the service bound to loopback unless a TLS reverse proxy is configured.
TAJ_BIND_ADDRESS=127.0.0.1
TAJ_PORT=8000
JOB_SEARCH_SOURCES=arbeitnow,remoteok
